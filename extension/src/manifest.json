{
  "manifest_version": 3,
  "name": "Jivika Clipper",
  "short_name": "Jivika",
  "version": "0.1.0",
  "description": "Send the job you are viewing to Jivika. Reads only the current tab, only when you click.",
  "homepage_url": "https://jivika.abhimanyu.fyi/clipper/",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Clip this job to Jivika",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "browser_specific_settings": { "gecko": { "id": "clipper@jivika.abhimanyu.fyi", "strict_min_version": "128.0" } }
}
