{
  "manifest_version": 3,
  "name": "Jivika Clipper",
  "short_name": "Jivika",
  "version": "0.2.0",
  "description": "Send the job or LinkedIn profile you are viewing to Jivika, and fill applications on request. Reads only the current tab, only when you click.",
  "homepage_url": "https://jivika.abhimanyu.fyi/clipper/",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "scripts": ["fill.js", "background.js"] },
  "externally_connectable": { "matches": ["https://jivika.abhimanyu.fyi/*", "http://localhost/*", "http://127.0.0.1/*"] },
  "action": {
    "default_title": "Clip this page to Jivika",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "browser_specific_settings": { "gecko": { "id": "clipper@jivika.abhimanyu.fyi", "strict_min_version": "128.0" } }
}
