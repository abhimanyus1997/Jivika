# Jivika needs no server-side model keys. Users supply their own key in the browser.
# The optional demo key below lets visitors try the AI tools before adding one.
# All settings below are optional. Copy to .env for local development.

# SQLite database for the Pro waitlist (directory is created if missing).
# The Docker image sets this to /data/jivika.db.
# JIVIKA_DB_PATH=./data/jivika.db

# Upstash Redis REST credentials. When set, the waitlist is stored in Redis instead of SQLite.
# Vercel Marketplace (Upstash for Redis) sets the KV_* names; UPSTASH_REDIS_REST_URL/TOKEN also work.
# On Vercel (VERCEL=1) the waitlist returns 503 without these, since the filesystem is not persistent.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Serve the whole app under a sub-path. Other paths redirect into it. Build the frontend with the
# matching VITE_BASE_PATH (for example VITE_BASE_PATH=/jivika/ npm run build).
# JIVIKA_BASE_PATH=/jivika

# Bearer token for GET /api/admin/waitlist.csv. When unset, the endpoint returns 404.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# JIVIKA_ADMIN_TOKEN=

# Set to 1 behind a reverse proxy so rate limiting uses the client IP it reports: X-Vercel-Forwarded-For
# (or X-Real-IP) on Vercel, otherwise the last X-Forwarded-For entry (deliberate: the one the trusted proxy appended).
# Leave unset when the app is reachable directly, otherwise the header can be spoofed.
# JIVIKA_TRUST_PROXY=1

# Waitlist sign-ups allowed per client IP per 10 minutes (default 5). Raise it if a proxy hides visitor IPs.
# JIVIKA_RATE_LIMIT=5

# Set to 1 when served over HTTPS to send Strict-Transport-Security.
# JIVIKA_HSTS=1

# Comma-separated list of allowed CORS origins (only needed if the frontend is served from another origin).
# JIVIKA_CORS_ORIGINS=http://localhost:5173

# Maximum resume PDF upload size in megabytes (default 10). Use 4 on Vercel, which rejects bodies over 4.5 MB.
# JIVIKA_MAX_UPLOAD_MB=10

# --- Demo mode -------------------------------------------------------------------------------
# Owner-supplied Groq key used only when a request carries no X-LLM-Key. Server-side secret: it is
# never sent to the browser. Leave empty to disable demo mode (requests without a key get 401).
JIVIKA_DEMO_GROQ_KEY=
# Groq model for demo requests (clients cannot change it). Default: Groq's default model in jivika/schemas.py.
# JIVIKA_DEMO_MODEL=openai/gpt-oss-120b
# Demo requests allowed per client IP per clock hour (default 20) and for everyone per UTC day (default 500).
# Counters live in Upstash Redis when KV_REST_API_URL/TOKEN are set, otherwise in process memory.
# JIVIKA_DEMO_HOURLY_LIMIT=20
# JIVIKA_DEMO_DAILY_LIMIT=500

# --- Job search ---------------------------------------------------------------------------------
# Sources queried by /api/jobs/search (default remotive,arbeitnow,adzuna,ats). The research sources
# linkedin and naukri fetch public listings on demand and are only used when listed here explicitly,
# e.g. remotive,arbeitnow,adzuna,ats,linkedin,naukri. They may be unavailable at any time.
# JIVIKA_JOB_SOURCES=remotive,arbeitnow,adzuna,ats
# Adzuna is used only when both values are set (free keys at https://developer.adzuna.com).
# JIVIKA_ADZUNA_APP_ID=
# JIVIKA_ADZUNA_APP_KEY=
# Two-letter Adzuna country code (default in).
# JIVIKA_ADZUNA_COUNTRY=in
# Company career boards for the "ats" source: comma-separated greenhouse:<slug>, lever:<slug> or
# ashby:<slug>. Defaults to a built-in list of companies hiring in India (see jivika/jobs.py).
# JIVIKA_ATS_BOARDS=greenhouse:groww,lever:cred,ashby:sarvam
# Job searches allowed per client IP per 10 minutes (default 30).
# JIVIKA_JOBS_RATE_LIMIT=30

# Frontend build-time values live in frontend/.env (VITE_SITE_URL, VITE_CONTACT_EMAIL, VITE_COMPANY_NAME),
# plus VITE_BASE_PATH (default /) for sub-path deployments.
